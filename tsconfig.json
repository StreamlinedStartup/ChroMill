{
  "extends": "./node_modules/plasmo/templates/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome",
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "jsx": "react",
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/run-radar/**/*.ts",
    "tests/run-radar/**/*.tsx",
    ".plasmo/index.d.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
